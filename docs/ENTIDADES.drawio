keColor=#2f7a3a;fontColor=#2f7a3a;dashed=1;startArrow=ERmany;endArrow=ERmandOne;startSize=10;endSize=10;endFill=0;startFill=0;edgeStyle=elbowEdgeStyle;elbow=horizontal;exitX=0;exitY=0.4607;entryX=1;entryY=0.5;" edge="1" parent="1" source="c167" target="c119"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="809"/></Array></mxGeometry></mxCell><mxCell id="c302" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2f7a3a;fontColor=#2f7a3a;dashed=1;startArrow=ERmany;endArrow=ERmandOne;startSize=10;endSize=10;endFill=0;startFill=0;edgeStyle=elbowEdgeStyle;elbow=horizontal;exitX=0;exitY=0.5393;entryX=1;entryY=0.5;" edge="1" parent="1" source="c167" target="c132"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="352" y="831"/></Array></mxGeometry></mxCell><mxCell id="c303" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2f7a3a;fontColor=#2f7a3a;dashed=1;startArrow=ERmany;endArrow=ERmandOne;startSize=10;endSize=10;endFill=0;startFill=0;edgeStyle=elbowEdgeStyle;elbow=horizontal;exitX=0;exitY=0.6179;entryX=1;entryY=0.5;" edge="1" parent="1" source="c167" target="c142"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="364" y="853"/></Array></mxGeometry></mxCell><mxCell id="c304" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2f7a3a;fontColor=#2f7a3a;dashed=1;startArrow=ERmany;endArrow=ERmandOne;startSize=10;endSize=10;endFill=0;startFill=0;edgeStyle=elbowEdgeStyle;elbow=horizontal;exitX=0;exitY=0.6964;entryX=1;entryY=0.5;" edge="1" parent="1" source="c167" target="c149"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="376" y="875"/></Array></mxGeometry></mxCell><mxCell id="c305" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2f7a3a;fontColor=#2f7a3a;dashed=1;startArrow=ERmany;endArrow=ERmandOne;startSize=10;endSize=10;endFill=0;startFill=0;edgeStyle=elbowEdgeStyle;elbow=horizontal;exitX=0;exitY=0.775;entryX=1;entryY=0.5;" edge="1" parent="1" source="c167" target="c158"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="388" y="897"/></Array></mxGeometry></mxCell><mxCell id="c306" value="&lt;b style=&quot;font-size:14px;color:#0e573f&quot;&gt;Leitura do modelo&lt;/b&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp; &lt;b&gt;13&lt;/b&gt; entidades hoje; &lt;b&gt;5&lt;/b&gt; cadastros ainda não existem e vivem como texto livre dentro da cirurgia.&lt;br&gt;&lt;br&gt;•&amp;nbsp; Ligações por ID ou uid: &lt;b&gt;4&lt;/b&gt;. Por nome ou texto: &lt;b&gt;7&lt;/b&gt; — e renomear um anestesista exige cascata.&lt;br&gt;&lt;br&gt;•&amp;nbsp; A &lt;b&gt;cirurgia não tem uid&lt;/b&gt;, e o &lt;b&gt;exame&lt;/b&gt; mora fora do estado (sem tipo, data da coleta nem hash).&lt;br&gt;&lt;br&gt;•&amp;nbsp; Sem a entidade &lt;b&gt;Paciente&lt;/b&gt;, o mesmo paciente em duas cirurgias não se correlaciona.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ordem sugerida:&lt;/b&gt; 1) backup externo com teste de restauração · 2) banco transacional e exclusão lógica · 3) Paciente e uid em todas as entidades." style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontSize=12.5;fontColor=#0e1a16;fillColor=#ffffff;strokeColor=#ccd5d1;" vertex="1" parent="1"><mxGeometry x="860" y="345" width="840" height="225" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>